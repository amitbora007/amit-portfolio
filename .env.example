# Server Configuration
PORT=5000
FRONTEND_URL=

# AI Chat Assistant Configuration (Optional — Gemini 2.0 / 1.5 Flash API Key or OpenAI API Key)
# If provided, the terminal AI Assistant uses LLM inference. If blank, it uses local Knowledge Base fallback.
GEMINI_API_KEY=
OPENAI_API_KEY=

# SMTP Server Credentials (e.g. Resend, Gmail App Password, Mailgun, SendGrid)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=

# Contact Receiver (Destination email for contact form submissions)
CONTACT_RECEIVER=
